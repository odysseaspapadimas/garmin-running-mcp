# Copy to .env.prod (chmod 600) and fill these locally. Never commit .env.prod.
# Select the right account if your Alchemy profile has more than one.
CLOUDFLARE_ACCOUNT_ID=
ACCESS_EMAIL=
# Generate with: openssl rand -base64 32
GARMIN_TOKEN_KEY=
# Only for a Cloudflare account without a Zero Trust organization:
# NEW_ACCESS_TEAM_DOMAIN=your-new-team.cloudflareaccess.com
# Garmin password/MFA are prompted interactively, never stored here.
